# Server
NODE_ENV=development
PORT=3001
ALLOWED_ORIGINS=
ALLOW_ALL_ORIGINS=false
ENABLE_DEBUG_ROUTES=false
MAINTENANCE_MODE=false

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alertup?connection_limit=10
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/alertup_test
# MONGO_STRING=            # ETL source only — remove after cutover

# Auth
JWT_SECRET=
ADMIN_USER=
ADMIN_PASS=

# Email (SendGrid)
SENDGRID_API_KEY=
EMAIL_FROM=noreply@alertup.world
EMAIL_REPLY_TO=
GMAIL_USER=                # contact-form / admin-login notification recipient

# AWS S3
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=alertup-assets
S3_PUBLIC_BASE_URL=        # optional CDN base override

# Groq AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_MAX_TOKENS=300
AI_DISABLED=false

# URLs
API_BASE_URL=http://localhost:3001
APP_BASE_URL=http://localhost:5173
CLIENT_SCAN_QR_URL=https://www.alertup.world
