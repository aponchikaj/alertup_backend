# Backend environment variables - example
# Copy this file to .env and fill values before deploying

NODE_ENV=production
PORT=3001

# MongoDB connection string
MONGO_STRING=

# JWT secret
JWT_SECRET=

# CORS
# Comma-separated list of allowed origins (exact origins)
ALLOWED_ORIGINS=https://alertup.vercel.app,https://alertup.world
# Set to true only for temporary debugging
ALLOW_ALL_ORIGINS=false

# Client URL used for QR scans
CLIENT_SCAN_QR_URL=https://alertup.world/scan

# NowPayments.io - Crypto Payment Provider
# Payment invoice IDs are configured in services/nowpayments.js

# SendGrid
SENDGRID_API_KEY=
GMAIL_USER=

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin
ADMIN_USER=
ADMIN_PASS=
