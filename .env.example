# Server
NODE_ENV=development
PORT=3001
# Prod backend:  https://alertup.world,https://www.alertup.world
# Stage backend: https://stage.alertup.world,https://pre-prod.alertup.world,http://localhost:5173
ALLOWED_ORIGINS=
ALLOW_ALL_ORIGINS=false
ENABLE_DEBUG_ROUTES=false
MAINTENANCE_MODE=false

# Database (PostgreSQL — Supabase)
# Two Supabase projects exist; use the IPv4 session pooler (port 5432), and
# URL-encode special chars in the password (@ -> %40).
#   STAGE (AlertUp_stage) — used by local dev, stage AND pre-prod deployments:
#     postgresql://postgres.gtqgozkyqlmqnxtjfsmu:<PASSWORD>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?connection_limit=5
#   PROD (AlertUp) — used ONLY by the production backend (alertup.world):
#     postgresql://postgres.moyrsobktliywdladxsl:<PASSWORD>@aws-1-eu-west-2.pooler.supabase.com:5432/postgres?connection_limit=5
DATABASE_URL=
# Jest uses this LOCAL db only — must never point at Supabase.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/alertup_test
# MONGO_STRING=            # ETL source only — remove after cutover

# Auth
JWT_SECRET=
ADMIN_USER=
ADMIN_PASS=

# Email — Resend primary, SendGrid fallback (see services/sendEmail.js).
# SendGrid stays wired through the cutover: Resend will not deliver until the
# domain's DNS verifies, and this mail carries password resets, 2FA codes and
# building invites. Set EMAIL_PROVIDER=sendgrid to flip the order back.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=noreply@alertup.world
EMAIL_REPLY_TO=
GMAIL_USER=                # contact-form / admin-login notification recipient

# Object storage (S3-compatible: AWS S3 or Cloudflare R2)
#
# The STORAGE_* names are canonical. The old AWS_*/S3_* names are still read as
# a fallback so a half-migrated deploy keeps working — remove them once every
# environment sets STORAGE_*.
#
#   AWS S3:  leave STORAGE_ENDPOINT empty, STORAGE_REGION=eu-central-1
#   R2:      STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#            STORAGE_REGION=auto            (R2 ignores region; 'auto' is required)
#
STORAGE_ENDPOINT=
STORAGE_REGION=eu-central-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=alertup   # the R2 bucket
# Public base for generated asset URLs.
# OPTIONAL on S3 (defaults to the bucket's amazonaws.com host).
# REQUIRED on R2 — buckets are private by default and the r2.dev subdomain is
# rate-limited and unsupported for production. Bind a custom domain to the
# bucket and point this at it; that also puts Cloudflare's CDN in front.
STORAGE_PUBLIC_BASE_URL=   # e.g. https://assets.alertup.world
# Hosts that served assets in an earlier era, comma-separated. Rows outlive
# migrations, so delete has to still recognise old absolute URLs as ours.
STORAGE_LEGACY_HOSTS=      # e.g. alertup-assets.s3.eu-central-1.amazonaws.com

# AI — Gemini primary, Groq fallback (see features/ai/aiClient.js).
# The fallback is not decoration: Gemini's free tier caps requests per minute
# and per day, and a 429 would otherwise take the emergency concierge down.
AI_PROVIDER=gemini

# Gemini (Google AI Studio — https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Model ids move quickly; override here rather than editing config defaults.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DESIGN_MODEL=gemini-3.8-flash
# Reads uploaded floor-plan images. Set empty to disable image analysis.
GEMINI_VISION_MODEL=gemini-3.8-flash

# Groq (fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: stronger model for the floor-plan designer (falls back to GROQ_MODEL).
GROQ_DESIGN_MODEL=
# Multimodal model that reads uploaded floor-plan images. Set empty to disable.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_MAX_TOKENS=300
AI_DISABLED=false

# URLs
API_BASE_URL=http://localhost:3001
APP_BASE_URL=http://localhost:5173
CLIENT_SCAN_QR_URL=https://www.alertup.world
