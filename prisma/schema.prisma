generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Migrated rows keep their Mongo ObjectId 24-hex string as the primary key so
// QR codes printed in the field (qr_{buildingId}_{floor}_{nodeId}) keep
// resolving with a plain findUnique. New rows get cuid() — 25 chars starting
// with "c", no underscores, cannot collide with 24-hex.

enum UserType {
  INDIVIDUAL
  COMPANY
}

// Subscription tier. Gates capacity (buildings, floors per building), not
// features — safety features are never paywalled in evacuation software.
enum Plan {
  FREE
  STARTER
  BUSINESS
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum NodeType {
  NORMAL
  ENTRANCE
  TRANSIT
  POI
  EMERGENCY_EXIT
}

enum TransitType {
  WALKWAY
  ELEVATOR
  ESCALATOR
  STAIRS
}

enum EmergencyStatus {
  ACTIVE
  RESOLVED
}

enum EmergencyTrigger {
  ADMIN
  SYSTEM
  MANUAL
  SENSOR
}

enum LogType {
  SYSTEM
  REPORT
  ERROR
  SCAN
  EVACUATED
  EMERGENCY
}

enum EdgeDirection {
  BOTH
  FORWARD
  REVERSE
}

enum EdgeRank {
  PRIMARY
  SECONDARY
}

enum Visibility {
  PUBLIC
  STAFF
  EMERGENCY_ONLY
}

enum ActorType {
  USER
  SYSTEM
  INTEGRATION
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String?
  name             String    @default("")
  lastname         String    @default("")
  company          String    @default("")
  tokenVersion     Int       @default(0)
  country          String?
  countryCode      String?
  phone            String?
  verified         Boolean   @default(false)
  userType         UserType?
  // New accounts start FREE; rows that existed before the FREE tier keep the
  // STARTER default they were migrated with (grandfathering, not generosity).
  plan             Plan      @default(FREE)
  twoFactorEnabled Boolean   @default(false)
  trustedIps       String[]  @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  ownedBuildings  Building[]       @relation("BuildingOwner")
  memberships     BuildingMember[]
  invitesSent     BuildingInvite[] @relation("InviteSender")
  verifications   Verification[]
  scanEvents      ScanEvent[]
  aiConversations AiConversation[]
  emergencies     EmergencyEvent[] @relation("EmergencyTriggeredBy")
  reviews         Review[]
}

model Building {
  id               String   @id @default(cuid())
  name             String
  ownerId          String
  owner            User     @relation("BuildingOwner", fields: [ownerId], references: [id])
  isDeactivated    Boolean  @default(false)
  emergencyMode    Boolean  @default(false)
  emergencyMessage String?
  // Per-building routing tuning (weights, tag rules, etc.) — free-form until
  // the profile shape stabilizes; consumed by the wayfinding profile resolver.
  routingProfile   Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  floors          Floor[]
  nodes           Node[]
  edges           Edge[]
  roles           Role[]
  members         BuildingMember[]
  invites         BuildingInvite[]
  emergencies     EmergencyEvent[]
  logs            Log[]
  scanEvents      ScanEvent[]
  aiConversations AiConversation[]
  closures        Closure[]
  routeRequests   RouteRequest[]
  searchEvents    SearchEvent[]
  realtimeEvents  RealtimeEvent[]

  @@index([ownerId])
  @@index([name])
}

// Custom role builder: each building owns its roles. permissions[] holds keys
// validated in code against src/auth/permissions.js. isSystem marks the five
// seeded defaults (non-deletable).
model Role {
  id          String   @id @default(cuid())
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name        String
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members BuildingMember[]
  invites BuildingInvite[]

  @@unique([buildingId, name])
  @@index([buildingId])
}

model BuildingMember {
  id          String   @id @default(cuid())
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String
  role        Role     @relation(fields: [roleId], references: [id])
  invitedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([buildingId, userId])
  @@index([userId])
  @@index([roleId])
}

model BuildingInvite {
  id           String       @id @default(cuid())
  buildingId   String
  building     Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  email        String
  roleId       String
  role         Role         @relation(fields: [roleId], references: [id])
  tokenHash    String       @unique
  status       InviteStatus @default(PENDING)
  expiresAt    DateTime
  invitedById  String
  invitedBy    User         @relation("InviteSender", fields: [invitedById], references: [id])
  acceptedById String?
  acceptedAt   DateTime?
  createdAt    DateTime     @default(now())
  // partial unique (buildingId, lower(email)) WHERE status='PENDING' — raw SQL migration

  @@index([buildingId, status])
  @@index([email])
}

model Floor {
  id                  String   @id @default(cuid())
  buildingId          String
  building            Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floorNumber         Int
  name                String?
  // Display order for multi-floor UI (floor pickers, stepper) independent of
  // floorNumber, which can be non-contiguous (basements, mezzanines).
  verticalOrder       Int?
  // Short label for compact UI (floor chips, breadcrumbs) — e.g. "G", "M2".
  shortName           String?
  mapImageUrl         String?
  qrCodeUrl           String?
  svgContent          String?  @db.Text
  // Hand-drawn floor plan: { version, shapes[] } as authored in the map editor.
  // Rendered underneath the node graph in place of an uploaded plan image, and
  // shipped to visitors so a drawn floor looks the same in wayfinding. Shapes
  // are presentation only — routing still runs on Node/Edge, which is why a
  // stamped lift also creates a TRANSIT node rather than being inferred here.
  drawing             Json?
  width               Int?
  height              Int?
  scalePixelsPerMeter Float?
  scanCount           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  nodes Node[]

  @@unique([buildingId, floorNumber])
}

model Node {
  id         String   @id @default(cuid())
  floorId    String
  floor      Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  x          Float
  y          Float
  type       NodeType
  label      String?
  qrSlug     String?    @unique
  // Integrator-supplied stable id (e.g. a booth code) for external references
  // that must survive a map redraw; unique per building, reusable across them.
  externalId String?
  visibility Visibility @default(PUBLIC)
  scanCount  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  poi        Poi?
  edgesFrom  Edge[]      @relation("EdgeSource")
  edgesTo    Edge[]      @relation("EdgeTarget")
  scanEvents ScanEvent[]

  @@unique([buildingId, externalId])
  @@index([floorId])
  @@index([buildingId])
  @@index([buildingId, type])
}

model Poi {
  id          String   @id @default(cuid())
  nodeId      String   @unique
  node        Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  // Denormalized from node.buildingId (backfilled in the migration) so a POI
  // can be looked up/scoped without a join through Node, and so externalId
  // uniqueness can be scoped per building. Not a Prisma relation — the map
  // editor never reassigns a POI's building, so keeping it a plain column
  // avoids a second FK to maintain alongside Node's.
  buildingId  String?
  // Integrator-supplied stable id (e.g. a catalog SKU), unique per building.
  externalId  String?
  name        String
  category    String?
  description String?
  keywords    String[] @default([])
  // Localized display names/aliases: { en?, ka?, aliases[] }.
  names       Json?
  // Precomputed lowercase search blob (name + keywords), backfilled in the
  // migration; kept in sync by application code on writes.
  searchText  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([buildingId, externalId])
  @@index([keywords], type: Gin)
  @@index([name])
}

// Undirected edges stored once with sourceNodeId < targetNodeId (CHECK added
// via raw SQL migration). The graph loader expands both directions in memory.
model Edge {
  id           String      @id @default(cuid())
  sourceNodeId String
  targetNodeId String
  source       Node        @relation("EdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  target       Node        @relation("EdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)
  buildingId   String
  building     Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  distance     Float
  weight       Float
  accessible   Boolean       @default(true)
  transitType  TransitType   @default(WALKWAY)
  // Real-world length in meters, independent of the px `distance`/`weight`
  // used for on-canvas layout — populated once floors carry a known scale.
  lengthM      Float?
  direction    EdgeDirection @default(BOTH)
  tags         String[]      @default([])
  rank         EdgeRank      @default(PRIMARY)
  visibility   Visibility    @default(PUBLIC)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([sourceNodeId, targetNodeId])
  @@index([buildingId])
  @@index([targetNodeId])
}

model EmergencyEvent {
  id              String           @id @default(cuid())
  buildingId      String
  building        Building         @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  status          EmergencyStatus  @default(ACTIVE)
  trigger         EmergencyTrigger @default(ADMIN)
  triggeredById   String?
  triggeredBy     User?            @relation("EmergencyTriggeredBy", fields: [triggeredById], references: [id])
  message         String?
  scanned         Int              @default(0)
  evacuated       Int              @default(0)
  calledEmergency Int              @default(0)
  startedAt       DateTime         @default(now())
  endedAt         DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([buildingId, status])
}

model Log {
  id          String    @id @default(cuid())
  buildingId  String
  building    Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  type        LogType   @default(SYSTEM)
  message     String
  isEmergency Boolean   @default(false)
  // Who/what caused this log row — nullable because most historical rows and
  // system-generated entries have no single actor.
  actorUserId String?
  actorType   ActorType @default(SYSTEM)
  // What the log is about (e.g. "Closure", "Edge") plus its id, so an audit
  // trail can be filtered per entity without parsing `message`.
  entity      String?
  entityId    String?
  payload     Json?
  createdAt   DateTime  @default(now())

  @@index([buildingId, createdAt(sort: Desc)])
  @@index([buildingId, entity, entityId])
}

// A temporary routing obstruction (maintenance, incident, drill) affecting a
// set of edges/nodes on one floor. Referenced by id/edgeIds/nodeIds arrays
// rather than a join table since a closure is short-lived and read far more
// often than written — the router loads active closures per building/floor
// and applies costMultiplier (or treats it as fully blocked when null).
model Closure {
  id             String    @id @default(cuid())
  buildingId     String
  building       Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floorId        String?
  edgeIds        String[]  @default([])
  nodeIds        String[]  @default([])
  // Cost penalty multiplier applied to affected edges; null means blocked
  // outright rather than merely penalized.
  costMultiplier Float?
  reason         String?
  startsAt       DateTime  @default(now())
  endsAt         DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([buildingId, endsAt])
}

// One routing computation, for quality/analytics (success rate, distance
// distribution, which profiles get used) — deliberately lean, no PII beyond
// what src/profile/mode already imply.
model RouteRequest {
  id          String   @id @default(cuid())
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  fromNodeId  String?
  to          String?
  profile     String
  mode        String
  src         String?
  found       Boolean  @default(true)
  distanceM   Float?
  durationSec Float?
  createdAt   DateTime @default(now())

  @@index([buildingId, createdAt(sort: Desc)])
}

// One destination search, for search-quality analytics (zero-result queries,
// which POI actually got picked). String @id (not cuid) because these are
// written from a hot, unauthenticated path and the caller mints the id.
model SearchEvent {
  id          String   @id
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  query       String
  resultCount Int
  pickedPoiId String?
  createdAt   DateTime @default(now())

  @@index([buildingId, createdAt(sort: Desc)])
}

// Durable backlog for the SSE emergency/closure feed: every broadcast frame
// is persisted here first so a reconnecting client can replay everything
// after `sinceSeq`/`Last-Event-ID` instead of missing frames sent while it
// was offline. seq is a per-building monotonic counter, not a global one.
model RealtimeEvent {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  seq        BigInt
  event      String
  data       Json
  createdAt  DateTime @default(now())

  @@unique([buildingId, seq])
  @@index([createdAt])
}

// Mongo TTL replacement: lookups always filter expiresAt > now(); the sweeper
// job deletes expired rows every 10 minutes.
model Verification {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  codeHash     String
  expiresAt    DateTime
  verified     Boolean  @default(false)
  pendingEmail String?
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model ScanEvent {
  id           String   @id @default(cuid())
  buildingId   String
  building     Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Which sticker was scanned. Nullable because every row written before this
  // column existed has no answer, and SetNull because a re-drawn map deletes
  // nodes while the scan history has to survive it. Without this, "which
  // entrance do visitors actually use" is unanswerable.
  nodeId       String?
  node         Node?    @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  buildingName String
  scannedAt    DateTime @default(now())

  @@index([userId, scannedAt(sort: Desc)])
  @@index([buildingId, scannedAt(sort: Desc)])
  @@index([nodeId, scannedAt(sort: Desc)])
}

model Review {
  id        String    @id @default(cuid())
  userId    String?   @unique
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String
  userType  UserType?
  stars     Int       @default(1)
  comment   String?
  createdAt DateTime  @default(now())
}

model Contact {
  id          String   @id @default(cuid())
  email       String?
  message     String?
  contactType String?
  createdAt   DateTime @default(now())
}

model Report {
  id        String   @id @default(cuid())
  email     String?
  reason    String?
  message   String?
  createdAt DateTime @default(now())
}

/**
 * ============================================================================
 * AI agent conversations.
 * ----------------------------------------------------------------------------
 * Persisted for three reasons, in descending order of weight:
 * 1. Audit. After an incident an operator has to be able to answer "what did
 * the assistant tell occupants?" Nothing else in the system records that.
 * 2. Budget. Per-IP limits cannot express "this building has had enough
 * today" — and a whole building behind one NAT shares a single IP, so the
 * IP-shaped question is the wrong one.
 * 3. Memory across turns, which is the least important of the three.
 * Retention lives in jobs/sweeper.js: ordinary conversations are swept after
 * 30 days, emergency ones are kept — they are the audit record.
 * =========================================================================
 */
model AiConversation {
  id      String @id @default(cuid())
  agentId String

  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  // Null for anonymous visitors, who are most of the traffic: scan pages have
  // no login and never will.
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Where the visitor scanned in, denormalized like ScanEvent.buildingName:
  // the audit record must stay readable after the map is redrawn.
  nodeId      String?
  // Set when the conversation was opened while this emergency was ACTIVE. It
  // is what makes a row an audit record rather than a transcript, so the
  // sweeper keys retention on it.
  emergencyId String?

  locale    String   @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiMessage[]

  @@index([buildingId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([emergencyId])
}

// One turn. Tool calls are rows here with role 'tool' rather than their own
// model: they are read in sequence with the turns around them, and a separate
// table would only add a join to every read.
model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // 'user' | 'assistant' | 'tool'
  role    String
  content String @db.Text

  toolName String?
  toolArgs Json?
  toolOk   Boolean?

  // Which provider actually answered — the fallback is invisible to the user
  // by design, so without this an incident review cannot tell Gemini from Groq.
  provider String?
  model    String?
  // True when the static localized fallback answered instead of a model.
  fallback Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}
